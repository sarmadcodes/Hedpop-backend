PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hedpop
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Optional. When set the backend can send FCM push notifications.
# Path to a Firebase service-account JSON file.
FIREBASE_SA_PATH=

# OAuth. Leave blank to disable a provider.
# Google: console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
# Facebook: developers.facebook.com -> your app -> Settings -> Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
